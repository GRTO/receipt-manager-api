{
  "name": "receipt-manager-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/app.test.js dist/auth.test.js dist/db/database.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "db:migrate": "npm run build && node dist/db/migrate.js up",
    "db:rollback": "npm run build && node dist/db/migrate.js down",
    "test:db": "npm run build && node --test dist/db/database.test.js"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
